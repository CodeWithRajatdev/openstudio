# Woodpecker Crossword Book Studio Environment Configuration
# Copy to backend/.env for local overrides. Never commit real .env files or API keys.

DATABASE_URL=sqlite:///./data/woodpecker.db

# Clue Generation Providers
DICTIONARY_PROVIDER=wordnet        # wordnet | jsonl | none
DICTIONARY_JSONL_PATH=
AI_PROVIDER=anthropic              # anthropic | fake | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Custom TrueType fonts directory for PDF/PNG rendering (in addition to Open Sans & Bitstream Vera)
FONT_DIR=
